# -----------------------------------------------------------------------------
# Copie para .env e ajuste:   cp .env.example .env && chmod 600 .env
# NUNCA versionar o .env (contém segredo).
# -----------------------------------------------------------------------------

# --- Imagem ----------------------------------------------------------------
APP_VERSION=1.0.0
# Revisão da imagem (muda quando Dockerfile/Tomcat mudam sem mudar o WAR)
IMAGE_REVISION=2
BUILD_IMAGE=tomcat:10.1-jdk25-temurin
# Se a tag JRE não existir no seu registry, use tomcat:10.1-jdk25-temurin
RUNTIME_IMAGE=tomcat:10.1-jre25-temurin
REDIS_IMAGE=redis:7.4-alpine
PROXY_IMAGE=nginxinc/nginx-unprivileged:stable-alpine

# --- Portas -----------------------------------------------------------------
# Públicas (proxy): 80 redireciona para 443
HOST_HTTP_PORT_PUBLIC=80
HOST_HTTPS_PORT=443
# Tomcat direto, só em 127.0.0.1 do servidor (diagnóstico/scripts)
HOST_HTTP_PORT=8080
# Pasta com tls.crt (cert + intermediárias) e tls.key (sem senha)
TLS_CERT_DIR=./certs

# --- Redis (container "redis" na mesma rede Docker) -------------------------
# Gere com:  openssl rand -base64 32 | tr -d '=+/'
REDIS_PASSWORD=TROQUE_POR_UMA_SENHA_FORTE
# false = Fase 1 (sem TLS). Para validar TLS use o overlay docker-compose.tls.yml
REDIS_SSL=false
REDIS_PORT=6379
REDIS_TIMEOUT_MS=2000
BRIDGE_REDIS_MAX_TOTAL=10
BRIDGE_REDIS_MAX_WAIT_MS=1000

# --- Transações ---------------------------------------------------------------
BRIDGE_TRANSACTION_STORE=redis
BRIDGE_TRANSACTION_KEY_PREFIX=iwlcb:txn:
BRIDGE_TRANSACTION_TTL_SECONDS=60

# --- Plataforma Senior (validação da credencial de serviço) -----------------
# PRODUCTION | HOMOLOGATION | DEV_PRODUCTS | DEV_ARCHITECTURE
# Deve corresponder ao ambiente da credencial (Bearer) usada nos testes.
BRIDGE_PLATFORM_ENV=HOMOLOGATION
# BRIDGE_PLATFORM_URL=            # override opcional
BRIDGE_PLATFORM_CONNECT_TIMEOUT_MS=2000
BRIDGE_PLATFORM_READ_TIMEOUT_MS=3000

# --- Segurança / operação ---------------------------------------------------
BRIDGE_ALLOWED_RETURN_SCHEME=https
BRIDGE_RATE_LIMIT_PER_MINUTE=300
BRIDGE_RATE_LIMIT_BURST=50
# false: /health só {"status":"UP"} e sem header X-App-Version (evita fingerprinting)
BRIDGE_HEALTH_VERBOSE=false
